# Gemini free key from AI Studio. Never commit a real key.
GEMINI_API_KEY=
# Optional. Used when the first key hits a daily limit.
GEMINI_API_KEY_2=
# fake = no real calls, used during builds to save free-tier quota. real = call Gemini.
LLM_MODE=fake
# 1 = reuse identical replies across retakes and restarts (labelled "cache" in the app).
LLM_CACHE=0
MODEL_MAIN=gemini-2.5-flash
DB_PATH=./data/app.db
